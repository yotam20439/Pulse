# Neon — use the POOLED connection string for the app,
# and the DIRECT (non-pooled) one for drizzle-kit migrations.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/pulse?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/pulse?sslmode=require"

# Auth.js v5
AUTH_SECRET="run: npx auth secret"
# Local only. Do NOT set AUTH_URL on Vercel — Auth.js reads the deployment URL
# itself, and a stale value here breaks the OAuth callback.
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Protects /api/cron/* — Vercel Cron sends this as a Bearer token.
CRON_SECRET=""

# Metric providers (leave blank to run the mock collector)
INSTAGRAM_GRAPH_TOKEN=""
TIKTOK_DISPLAY_API_KEY=""
YOUTUBE_API_KEY=""

# AI insights
ANTHROPIC_API_KEY=""
